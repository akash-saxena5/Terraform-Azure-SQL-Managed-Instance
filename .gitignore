crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment and credentials
.env
.env.*
.terraformrc
terraform.rc

# Operating system files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

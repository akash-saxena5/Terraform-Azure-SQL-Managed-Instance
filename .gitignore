
# Terraform local directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
*.tfplan.*
tfplan
tfplan.*

# Terraform variable files
*.tfvars
